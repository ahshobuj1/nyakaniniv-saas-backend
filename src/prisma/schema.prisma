generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  firstName      String?         @map("first_name") @db.VarChar(255)
  lastName       String?         @map("last_name") @db.VarChar(255)
  email          String          @unique @db.VarChar(255)
  password       String          @db.VarChar(255)
  role           UserRole
  profileImg     String?         @map("profile_img") @db.VarChar(255)
  isVerified     Boolean?        @default(false) @map("is_verified")
  otp            String?         @db.VarChar(255)
  otpExpiry      DateTime?       @map("otp_expiry")
  createdAt      DateTime?       @default(now()) @map("created_at")
  updatedAt      DateTime?       @default(now()) @updatedAt @map("updated_at")
  auditLogs      AuditLog[]
  invoices       Invoice[]
  notifications  Notification[]
  subscriptions  Subscription[]
  supportTickets SupportTicket[]
  tenant         Tenant?
  transactions   Transaction[]

  @@map("users")
}

model Theme {
  id              Int       @id @default(autoincrement())
  name            String?   @db.VarChar(255)
  slug            String?   @db.VarChar(255)
  previewImageUrl String?   @map("preview_image_url") @db.VarChar(255)
  defaultConfig   Json?     @map("default_config")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at")
  tenants         Tenant[]

  @@map("themes")
}

model Tenant {
  id                        String                 @id @default(uuid()) @db.Uuid
  userId                    String?                @unique @map("user_id") @db.Uuid
  subdomain                 String?                @unique @db.VarChar(255)
  stageName                 String?                @map("stage_name") @db.VarChar(255)
  country                   String?                @db.VarChar(255)
  city                      String?                @db.VarChar(255)
  genres                    Json?
  themeId                   Int?                   @map("theme_id")
  logoUrl                   String?                @map("logo_url") @db.VarChar(255)
  bio                       String?
  timezone                  String?                @db.VarChar(255)
  currencyCode              String?                @default("KES") @map("currency_code") @db.VarChar(10)
  isActive                  Boolean?               @map("is_active")
  socialLinks               Json?                  @map("social_links")
  config                    Json?
  directPaymentInstructions Json?                  @map("direct_payment_instructions")
  createdAt                 DateTime?              @default(now()) @map("created_at")
  updatedAt                 DateTime?              @default(now()) @updatedAt @map("updated_at")
  activePlanId              Int?                   @map("active_plan_id")
  subscriptionStatus        SubscriptionStatus?    @map("subscription_status")
  flutterwaveSubaccountId   String?                @map("flutterwave_subaccount_id") @db.VarChar(255)
  paystackSubaccountId      String?                @map("paystack_subaccount_id") @db.VarChar(255)
  pesapalAccountId          String?                @map("pesapal_account_id") @db.VarChar(255)
  bookings                  Booking[]
  clients                   Client[]
  events                    Event[]
  invoices                  Invoice[]
  mixTapes                  MixTape[]
  payoutRequests            PayoutRequest[]
  paymentAccounts           TenantPaymentAccount[]
  bookingReviews            BookingReview[]
  theme                     Theme?                 @relation(fields: [themeId], references: [id])
  user                      User?                  @relation(fields: [userId], references: [id])
  transactions              Transaction[]
  wallet                    Wallet?

  @@map("tenants")
}

model SubscriptionPlan {
  id                 Int            @id @default(autoincrement())
  name               String?        @db.VarChar(255)
  priceMonthly       Decimal?       @map("price_monthly") @db.Decimal(10, 2)
  priceAnnually      Decimal?       @map("price_annually") @db.Decimal(10, 2)
  discountPercentage Int?           @map("discount_percentage")
  features           Json?
  createdAt          DateTime?      @default(now()) @map("created_at")
  updatedAt          DateTime?      @default(now()) @updatedAt @map("updated_at")
  isActive           Boolean        @default(true) @map("is_active")
  invoices           Invoice[]
  subscriptions      Subscription[]
  prices             SubscriptionPlanPrice[]

  @@map("subscription_plans")
}

model Subscription {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  planId    Int?                @map("plan_id")
  status    SubscriptionStatus?
  periodEnd DateTime?           @map("period_end")
  createdAt DateTime?           @default(now()) @map("created_at")
  updatedAt DateTime?           @default(now()) @updatedAt @map("updated_at")
  plan      SubscriptionPlan?   @relation(fields: [planId], references: [id])
  user      User?               @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model MixTape {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  title     String?   @db.VarChar(255)
  audioUrl  String?   @map("audio_url") @db.VarChar(255)
  coverUrl  String?   @map("cover_url") @db.VarChar(255)
  order     Int?
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])

  @@map("mix_tapes")
}

model Event {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String?      @map("tenant_id") @db.Uuid
  title        String?      @db.VarChar(255)
  description  String?
  eventDate    DateTime?    @map("event_date")
  venueName    String?      @map("venue_name") @db.VarChar(255)
  venueAddress String?      @map("venue_address") @db.VarChar(255)
  capacity     Int?
  price        Decimal?     @db.Decimal(10, 2)
  status       EventStatus?
  createdAt    DateTime?    @default(now()) @map("created_at")
  updatedAt    DateTime?    @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  eventTime    String?      @map("event_time") @db.VarChar(50)
  tenant       Tenant?      @relation(fields: [tenantId], references: [id])

  @@map("events")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String?       @map("tenant_id") @db.Uuid
  eventType     String?       @map("event_type") @db.VarChar(255)
  eventDetails  Json?         @map("event_details")
  status        BookingStatus @default(PENDING)
  totalAmount   Decimal       @default(0.00) @map("total_amount") @db.Decimal(18, 2)
  createdAt     DateTime?     @default(now()) @map("created_at")
  updatedAt     DateTime?     @default(now()) @updatedAt @map("updated_at")
  address       String?
  eventDate     DateTime?     @map("event_date")
  clientId      String?       @map("client_id") @db.Uuid
  deletedAt     DateTime?     @map("deleted_at")
  currencyCode  String?       @default("KES") @map("currency_code") @db.Char(3)
  eventTimezone String?       @map("event_timezone") @db.VarChar(100)

  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  payoutStatus  PayoutStatus  @default(NOT_ELIGIBLE) @map("payout_status")
  paymentDueAt  DateTime?     @map("payment_due_at")
  confirmedAt   DateTime?     @map("confirmed_at")
  completedAt   DateTime?     @map("completed_at")
  cancelledAt   DateTime?     @map("cancelled_at")

  orderReference        String?             @unique @map("order_reference") @db.VarChar(50)
  directPaymentStatus   DirectPaymentStatus @default(UNREPORTED) @map("direct_payment_status")
  completionRequestedAt DateTime?           @map("completion_requested_at")
  completionConfirmedAt DateTime?           @map("completion_confirmed_at")
  issueReportedAt       DateTime?           @map("issue_reported_at")
  issueDescription      String?             @map("issue_description")

  client        Client?             @relation(fields: [clientId], references: [id])
  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  invoice       Invoice?
  walletLedgers WalletLedger[]
  quotes        BookingQuote[]
  messages      BookingMessage[]
  auditEvents   BookingAuditEvent[]
  agreement     BookingAgreement?
  review        BookingReview?

  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, payoutStatus])
  @@index([eventDate])
  @@index([orderReference])
  @@map("bookings")
}

model Client {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  name      String?   @db.VarChar(255)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  bookings  Booking[]
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])

  @@map("clients")
}

model Invoice {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  tenantId     String?           @map("tenant_id") @db.Uuid
  planId       Int?              @map("plan_id")
  bookingId    String?           @unique @map("booking_id") @db.Uuid
  type         InvoiceType
  amount       Decimal           @db.Decimal(18, 2)
  status       InvoiceStatus     @default(UNPAID)
  dueDate      DateTime?         @map("due_date")
  createdAt    DateTime?         @default(now()) @map("created_at")
  updatedAt    DateTime?         @default(now()) @updatedAt @map("updated_at")
  currencyCode String?           @default("KES") @map("currency_code") @db.Char(3)
  booking      Booking?          @relation(fields: [bookingId], references: [id])
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  tenant       Tenant?           @relation(fields: [tenantId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("invoices")
}

model Transaction {
  id               String            @id @default(uuid()) @db.Uuid
  invoiceId        String?           @map("invoice_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  tenantId         String?           @map("tenant_id") @db.Uuid
  amount           Decimal           @db.Decimal(18, 2)
  currency         String            @default("KES") @db.VarChar(10)
  gateway          PaymentGateway
  channel          PaymentChannel    @default(UNKNOWN)
  status           TransactionStatus @default(PENDING)
  gatewayReference String?           @unique @map("gateway_reference") @db.VarChar(255)
  idempotencyKey   String?           @unique @map("idempotency_key") @db.VarChar(255)
  cardBrand        String?           @map("card_brand") @db.VarChar(50)
  cardLast4        String?           @map("card_last4") @db.VarChar(10)
  bankName         String?           @map("bank_name") @db.VarChar(100)
  accountName      String?           @map("account_name") @db.VarChar(255)
  metadata         Json?
  createdAt        DateTime?         @default(now()) @map("created_at")
  updatedAt        DateTime?         @default(now()) @updatedAt @map("updated_at")
  djNetEarning     Decimal?          @default(0.00) @map("dj_net_earning") @db.Decimal(18, 2)
  gatewayFee       Decimal?          @default(0.00) @map("gateway_fee") @db.Decimal(18, 2)
  grossAmount      Decimal?          @default(0.00) @map("gross_amount") @db.Decimal(18, 2)
  platformFee      Decimal?          @default(0.00) @map("platform_fee") @db.Decimal(18, 2)
  refundedAmount   Decimal?          @default(0.00) @map("refunded_amount") @db.Decimal(18, 2)
  remainingAmount  Decimal?          @default(0.00) @map("remaining_amount") @db.Decimal(18, 2)
  amountUsd        Decimal?          @map("amount_usd") @db.Decimal(18, 2)
  fxRate           Decimal?          @map("fx_rate") @db.Decimal(18, 8)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([tenantId, status])
  @@map("transactions")
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  type           String?   @db.VarChar(255)
  status         String?   @db.VarChar(255)
  createdAt      DateTime? @default(now()) @map("created_at")
  gateway        String    @default("PAYSTACK") @db.VarChar(50)
  gatewayEventId String    @unique @map("gateway_event_id") @db.VarChar(255)
  payload        Json?

  @@map("webhook_events")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  action    String?   @db.VarChar(255)
  metadata  Json?
  ipAddress String?   @map("ip_address") @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at")
  user      User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SupportTicket {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String?       @map("user_id") @db.Uuid
  fullName  String?       @map("full_name") @db.VarChar(255)
  email     String?       @db.VarChar(255)
  subject   String?       @db.VarChar(255)
  issue     String?
  status    TicketStatus?
  createdAt DateTime?     @default(now()) @map("created_at")
  user      User?         @relation(fields: [userId], references: [id])

  @@map("support_tickets")
}

model Notification {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String?           @map("user_id") @db.Uuid
  title       String?           @db.VarChar(255)
  message     String?
  type        NotificationType?
  isRead      Boolean?          @default(false) @map("is_read")
  createdAt   DateTime?         @default(now()) @map("created_at")
  referenceId String?           @map("reference_id") @db.VarChar(255)
  user        User?             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model LandingPageHero {
  id          Int      @id @default(autoincrement())
  title       String?  @db.VarChar(255)
  description String?
  isActive    Boolean? @default(false) @map("is_active")
  imageUrl1   String?  @map("image_url_1") @db.VarChar(255)
  imageUrl2   String?  @map("image_url_2") @db.VarChar(255)
  imageUrl3   String?  @map("image_url_3") @db.VarChar(255)

  @@map("landing_page_heroes")
}

model LandingPageStep {
  id          Int     @id @default(autoincrement())
  title       String? @db.VarChar(255)
  description String?
  imageUrl    String? @map("image_url") @db.VarChar(255)
  order       Int?

  @@map("landing_page_steps")
}

model LandingPageService {
  id          Int     @id @default(autoincrement())
  title       String? @db.VarChar(255)
  description String?
  imageUrl    String? @map("image_url") @db.VarChar(255)
  order       Int?

  @@map("landing_page_services")
}

model LandingPageFaq {
  id       Int     @id @default(autoincrement())
  question String? @db.VarChar(255)
  answer   String?
  order    Int?

  @@map("landing_page_faqs")
}

model LandingPageSocial {
  id       Int      @id @default(autoincrement())
  platform String   @db.VarChar(50)
  url      String   @db.VarChar(255)
  icon     String?  @db.VarChar(50)
  isActive Boolean? @default(true) @map("is_active")
  order    Int?

  @@map("landing_page_socials")
}

model LandingPageSetting {
  id            Int       @id @default(autoincrement())
  headerLogoUrl String?   @map("header_logo_url") @db.VarChar(255)
  footerLogoUrl String?   @map("footer_logo_url") @db.VarChar(255)
  siteName      String?   @default("UpBeat Africa") @map("site_name") @db.VarChar(255)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at")

  @@map("landing_page_settings")
}

model Currency {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.Char(3)
  name      String    @db.VarChar(100)
  symbol    String?   @db.VarChar(20)
  decimals  Int       @default(2)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  countries Country[]

  @@map("currencies")
}

model Country {
  id              Int                    @id @default(autoincrement())
  code            String                 @unique @db.Char(2)
  name            String                 @unique @db.VarChar(100)
  currencyCode    String                 @map("currency_code") @db.Char(3)
  timezone        String?                @db.VarChar(100)
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  currency        Currency               @relation(fields: [currencyCode], references: [code])
  paymentAccounts TenantPaymentAccount[]

  @@index([currencyCode])
  @@map("countries")
}

model TenantPaymentAccount {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  gateway      PaymentGateway
  accountId    String?        @map("account_id") @db.VarChar(255)
  subaccountId String?        @map("subaccount_id") @db.VarChar(255)
  countryCode  String?        @map("country_code") @db.Char(2)
  currencyCode String?        @map("currency_code") @db.Char(3)
  isActive     Boolean        @default(true) @map("is_active")
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  country      Country?       @relation(fields: [countryCode], references: [code])
  tenant       Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, gateway])
  @@index([tenantId])
  @@index([gateway])
  @@map("tenant_payment_accounts")
}

model Wallet {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @unique @map("tenant_id") @db.Uuid
  pendingBalance   Decimal         @default(0.00) @map("pending_balance") @db.Decimal(18, 2)
  availableBalance Decimal         @default(0.00) @map("available_balance") @db.Decimal(18, 2)
  totalWithdrawn   Decimal         @default(0.00) @map("total_withdrawn") @db.Decimal(18, 2)
  currency         String          @default("KES") @db.VarChar(10)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  totalEarnings    Decimal         @default(0.00) @map("total_earnings") @db.Decimal(18, 2)
  payoutRequests   PayoutRequest[]
  walletLedgers    WalletLedger[]
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model PayoutRequest {
  id                String              @id @default(uuid()) @db.Uuid
  walletId          String              @map("wallet_id") @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  amount            Decimal             @db.Decimal(18, 2)
  currency          String              @default("KES") @db.VarChar(10)
  gateway           PaymentGateway      @default(PAYSTACK)
  status            PayoutRequestStatus @default(PENDING)
  accountDetails    Json
  adminNote         String?             @map("admin_note")
  failureReason     String?             @map("failure_reason")
  processedAt       DateTime?           @map("processed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at")
  fee               Decimal             @default(0.00) @db.Decimal(18, 2)
  recipientCode     String?             @map("recipient_code") @db.VarChar(255)
  transferReference String?             @unique @map("transfer_reference") @db.VarChar(255)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet            Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("payout_requests")
}

model WalletLedger {
  id              String     @id @default(uuid()) @db.Uuid
  walletId        String     @map("wallet_id") @db.Uuid
  bookingId       String?    @map("booking_id") @db.Uuid
  amount          Decimal    @db.Decimal(18, 2)
  currency        String     @db.VarChar(10)
  type            LedgerType
  description     String     @db.VarChar(255)
  createdAt       DateTime   @default(now()) @map("created_at")
  newBalance      Decimal    @default(0.00) @map("new_balance") @db.Decimal(18, 2)
  paymentId       String?    @map("payment_id") @db.Uuid
  previousBalance Decimal    @default(0.00) @map("previous_balance") @db.Decimal(18, 2)
  referenceId     String?    @unique @map("reference_id") @db.VarChar(255)
  status          String?    @default("CONFIRMED") @db.VarChar(50)
  transferId      String?    @map("transfer_id") @db.Uuid
  wallet          Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  booking         Booking?   @relation(fields: [bookingId], references: [id])

  @@index([walletId])
  @@index([bookingId])
  @@index([referenceId])
  @@map("wallet_ledgers")
}

enum UserRole {
  SUPER_ADMIN
  DJ
  ADMIN
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum EventStatus {
  upcoming
  completed
  canceled
}

enum BookingStatus {
  PENDING
  ACCEPTED
  AWAITING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  NO_SHOW
  DISPUTED
}

enum DirectPaymentStatus {
  UNREPORTED
  CLIENT_REPORTED
  DJ_CONFIRMED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  NOT_ELIGIBLE
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum NotificationType {
  booking_request
  payment
  system
}

enum InvoiceType {
  SUBSCRIPTION
  BOOKING
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  PESAPAL
  DPO
  CELLULANT
  CASH
  MANUAL
}

enum PaymentChannel {
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  USSD
  CASH
  UNKNOWN
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PayoutRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
}

enum LedgerType {
  BOOKING_CREDIT_PENDING
  ESCROW_RELEASED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_FAILED_REVERSAL
  REFUND_ADJUSTMENT
}

model BookingQuote {
  id         String             @id @default(uuid()) @db.Uuid
  bookingId  String             @map("booking_id") @db.Uuid
  version    Int                @default(1)
  amount     Decimal            @db.Decimal(18, 2)
  currency   String             @default("KES") @db.Char(3)
  proposedBy String             @map("proposed_by") @db.VarChar(20) // "DJ" or "CLIENT"
  status     String             @default("PROPOSED") @db.VarChar(50) // "PROPOSED", "ACCEPTED", "REJECTED", "SUPERSEDED"
  notes      String?
  createdAt  DateTime           @default(now()) @map("created_at")
  acceptedAt DateTime?          @map("accepted_at")
  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agreements BookingAgreement[]

  @@index([bookingId])
  @@map("booking_quotes")
}

model BookingMessage {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  senderType String   @map("sender_type") @db.VarChar(20) // "DJ" or "CLIENT"
  senderId   String?  @map("sender_id") @db.Uuid
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_messages")
}

model BookingAgreement {
  id               String        @id @default(uuid()) @db.Uuid
  bookingId        String        @unique @map("booking_id") @db.Uuid
  quoteId          String?       @map("quote_id") @db.Uuid
  agreedAmount     Decimal       @map("agreed_amount") @db.Decimal(18, 2)
  currency         String        @default("KES") @db.Char(3)
  termsSnapshot    Json?         @map("terms_snapshot")
  acceptedByParty  String?       @map("accepted_by_party") @db.VarChar(20)
  clientAcceptedAt DateTime?     @map("client_accepted_at")
  djAcceptedAt     DateTime?     @map("dj_accepted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  quote            BookingQuote? @relation(fields: [quoteId], references: [id])

  @@map("booking_agreements")
}

model BookingAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  actorType String   @map("actor_type") @db.VarChar(20) // "DJ", "CLIENT", "SYSTEM", "ADMIN"
  actorId   String?  @map("actor_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_audit_events")
}

model BookingReview {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  rating     Int
  reviewText String?  @map("review_text")
  clientName String?  @map("client_name") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("booking_reviews")
}

model SubscriptionPlanPrice {
  id            String           @id @default(uuid()) @db.Uuid
  planId        Int              @map("plan_id")
  currencyCode  String           @map("currency_code") @db.VarChar(10)
  priceMonthly  Decimal          @map("price_monthly") @db.Decimal(10, 2)
  priceAnnually Decimal          @map("price_annually") @db.Decimal(10, 2)
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currencyCode])
  @@map("subscription_plan_prices")
}

